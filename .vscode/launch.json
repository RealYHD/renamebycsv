    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Module",
            "type": "python",
            "request": "launch",
            "module": "renamebycsv.cli",
            "args": [
                "${workspaceFolder}/tests/resources/files",
                "group\\d+-\\w-(\\d+)\\.txt",
                "${workspaceFolder}/tests/resources/groups.csv",
                "target",
                "replaced",
                "-d",
                "-e",
                "abc",
                "-k"
            ],
            "justMyCode": true
        }
    ]
}